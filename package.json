{
  "name": "mastra-zai-agent",
  "version": "1.0.0",
  "description": "Sample Mastra AI Agent using zai/glm-4.6v-flash model with Vite + React",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:ui": "vite",
    "dev:full": "concurrently \"npm run dev\" \"npm run dev:ui\"",
    "cli": "tsx src/cli.ts",
    "server": "tsx src/server.ts",
    "build:ui": "vite build --outDir dist-client",
    "build:server": "tsc",
    "build": "tsc && vite build --outDir dist-client",
    "start": "tsx src/server.ts"
  },
  "keywords": [
    "mastra",
    "agent",
    "zai",
    "glm-4.6v-flash",
    "react",
    "vite",
    "llm",
    "ai"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@ai-sdk/openai": "^1.1.9",
    "@mastra/core": "^1.58.0",
    "@mastra/rag": "^1.3.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "lucide-react": "^0.475.0",
    "multer": "^2.2.0",
    "pdf-parse": "^2.2.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.13.4",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
