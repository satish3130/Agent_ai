{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist-client",
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://agent-ai-oakl.onrender.com"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}