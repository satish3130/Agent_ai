# ==========================================
# Mastra AI + GLM-4.6V-Flash Environment Config
# ==========================================

# Choose Provider: "zhipu" (default), "openrouter", or "custom"
MODEL_PROVIDER=zhipu

# 1. Zhipu AI / Z.ai Setup (https://open.bigmodel.cn)
ZHIPU_API_KEY=your_zhipu_api_key_here
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# 2. OpenRouter Setup (https://openrouter.ai)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# 3. Custom / Local OpenAI-Compatible Server (vLLM, Ollama, LM Studio)
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=dummy-key

# Web Server Port
PORT=3000
